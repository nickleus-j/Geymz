
@{
    ViewBag.Title = "A star path finding";
}
@section Style
{
    <link rel="stylesheet" href="~/css/graph.css"/>
}
<h2>Path find</h2>
<div id="controls" class='clear'>

	    		<label for="selectWallFrequency">Wall Frequency: </label>
	    		<select id="selectWallFrequency">
	    			<option value=".1">10%</option>
	    			<option value=".2">20%</option>
	    			<option value=".3">30%</option>
	    			<option value=".4">40%</option>
	    		</select>
	    		<br />
	    		<label for="selectGridSize">Grid Size: </label>
	    		<select id="selectGridSize" name="selectGridSize">
	    			<option value="10">10x10</option>
	    			<option value="15">15x15</option>
	    			<option value="20">20x20</option>
	    			<option value="30">30x30</option>
	    			<option value="40" selected="selected">40x40</option>
	    			<option value="50">50x50</option>
	    			<option value="100">100x100</option>
	    			<option value="150">150x150</option>
	    		</select>

	    		<br />
	    		<label for="checkDebug">Show search info?</label>
	    		<input type="checkbox" name="checkDebug" id="checkDebug" />
	    		<br />
	    		<label for="searchDiagonal">Allow diagonal movement?</label>
	    		<input type="checkbox" name="searchDiagonal" id="searchDiagonal" />
	    		<br />
	    		<label for="generateWeights">Add random weights?</label>
	    		<input type="checkbox" name="generateWeights" id="generateWeights" />
	    		<br />
	    		<label for="displayWeights">Display weight values?</label>
	    		<input type="checkbox" name="displayWeights" id="displayWeights" />
	    		<br />
	    		<input type="button" id="btnGenerate" value="Generate New Map" />
	    		<fieldset id='weightsKey'>
	    			<legend>Key:</legend>
	    			<div>
	    			<span class="grid_item weight1" id="keyWeight3"></span> Weight of 1 </div>
	    			<div>
	    			<span class="grid_item weight3" id="keyWeight3"></span> Weight of 3 </div>
	    			<div>
	    			<span class="grid_item weight5" id="keyWeight3"></span> Weight of 5 </div>
	    			<div>
	    			<span class="grid_item wall" id="keyWall"></span> Wall (imapassable) </div>
	    		</fieldset>
				<br />
		<span id="message">Click on a grid position to search</span>
	    </div>
<div id="main">
	<div id="search_grid">Loading grid...</div>
</div>

@section Scripts{
    <script src="~/js/astar.js"></script>
    <script src="~/js/graph.js"></script>
    <script type="text/javascript">
        const generateRandom = (width, height, wallFrequency) => {
            const nodes = [];

            for (let x = 0; x < width; x++) {
                const nodeRow = [];

                for(let y = 0; y < height; y++) {
                    const isWall = Math.floor(Math.random() * (1 / wallFrequency));
                    nodeRow.push(isWall === 0 ? GraphNodeType.WALL : GraphNodeType.OPEN);
                }
                nodes.push(nodeRow);
            }

            return new Graph(nodes);
        };

        document.addEventListener('DOMContentLoaded', function() {
            const grid_el = document.getElementById('search_grid');
            const selectWallFrequency = document.getElementById('selectWallFrequency');
            const selectGridSize = document.getElementById('selectGridSize');
            const checkDebug = document.getElementById('checkDebug');
            const searchDiagonal = document.getElementById('searchDiagonal');

            const opts = {
                wallFrequency: selectWallFrequency.value,
                gridSize: selectGridSize.value,
                debug: checkDebug.checked,
                diagonal: searchDiagonal.checked
            };

            const grid = new GraphSearch(grid_el, opts, astar.search);

            document.getElementById('btnGenerate').addEventListener('click', () => {
                grid.initialize();
            });

            selectWallFrequency.addEventListener('change', function() {
                grid.setOption({wallFrequency: this.value});
                grid.initialize();
            });

            selectGridSize.addEventListener('change', function() {
                grid.setOption({gridSize: this.value});
                grid.initialize();
            });

            checkDebug.addEventListener('change', function() {
                grid.setOption({debug: this.checked});
            });

            searchDiagonal.addEventListener('change', function() {
                grid.setOption({diagonal: this.checked});
            });

            const generateWeights = document.getElementById('generateWeights');
            const weightsKey = document.getElementById('weightsKey');

            generateWeights.addEventListener('click', function() {
                if (this.checked) {
                    weightsKey.style.display = 'block';
                } else {
                    weightsKey.style.display = 'none';
                }
            });
            document.querySelector('footer').remove();
        });

        const css = { start: "start", finish: "finish", wall: "wall", active: "active" };

        class GraphSearch {
            constructor(graph, options, implementation) {
                this.graph_el = graph;
                this.search = implementation;
                this.opts = Object.assign(
                    {wallFrequency: 0.1, debug: true, gridSize: 10},
                    options
                );
                this.initialize();
            }

            setOption(opt) {
                this.opts = Object.assign(this.opts, opt);
                if('debug' in opt) {
                    this.drawDebugInfo(opt.debug);
                }
            }

            initialize() {
                this.grid = [];
                const nodes = [];
                const graph = this.graph_el;

                graph.innerHTML = '';

                const cellWidth = (graph.offsetWidth / this.opts.gridSize) - 2;
                const cellHeight = (graph.offsetHeight / this.opts.gridSize) - 2;
                let startSet = false;

                for(let x = 0; x < this.opts.gridSize; x++) {
                    const row = document.createElement('div');
                    row.className = 'clear';

                    const nodeRow = [];
                    const gridRow = [];

                    for(let y = 0; y < this.opts.gridSize; y++) {
                        const id = `cell_${x}_${y}`;
                        const cell = document.createElement('span');
                        cell.id = id;
                        cell.className = 'grid_item';
                        cell.setAttribute('x', x);
                        cell.setAttribute('y', y);
                        cell.style.width = cellWidth + 'px';
                        cell.style.height = cellHeight + 'px';
                        row.appendChild(cell);
                        gridRow.push(cell);

                        const isWall = Math.floor(Math.random() * (1 / this.opts.wallFrequency));

                        if(isWall === 0) {
                            nodeRow.push(GraphNodeType.WALL);
                            cell.classList.add(css.wall);
                        } else {
                            const generateWeights = document.getElementById('generateWeights');
                            const displayWeights = document.getElementById('displayWeights');
                            const cell_weight = (generateWeights.checked ? (Math.floor(Math.random() * 3)) * 2 + 1 : 1);

                            nodeRow.push(cell_weight);
                            cell.classList.add('weight' + cell_weight);

                            if (displayWeights.checked) {
                                cell.textContent = cell_weight;
                            }

                            if (!startSet) {
                                cell.classList.add(css.start);
                                startSet = true;
                            }
                        }
                    }

                    graph.appendChild(row);
                    this.grid.push(gridRow);
                    nodes.push(nodeRow);
                }

                this.graph = new Graph(nodes);

                // bind cell events
                const cells = graph.querySelectorAll('.grid_item');
                cells.forEach(cell => {
                    cell.addEventListener('click', () => this.cellClicked(cell));
                });
            }

            cellClicked(endCell) {
                const end = this.nodeFromElement(endCell);

                if(endCell.classList.contains(css.wall) || endCell.classList.contains(css.start)) {
                    return;
                }

                const cells = this.graph_el.querySelectorAll('.grid_item');
                cells.forEach(cell => cell.classList.remove(css.finish));

                endCell.classList.add(css.finish);
                const startCell = this.graph_el.querySelector('.' + css.start);
                const start = this.nodeFromElement(startCell);

                const sTime = new Date();
                const path = this.search(this.graph.nodes, start, end, this.opts.diagonal);
                const fTime = new Date();

                const messageEl = document.getElementById('message');

                if(!path || path.length === 0) {
                    messageEl.textContent = `couldn't find a path (${fTime - sTime}ms)`;
                    this.animateNoPath();
                } else {
                    messageEl.textContent = `search took ${fTime - sTime}ms.`;
                    if(this.opts.debug) {
                        this.drawDebugInfo(this.opts.debug);
                    }
                    this.animatePath(path);
                }
            }

            drawDebugInfo(show) {
                const cells = this.graph_el.querySelectorAll('.grid_item');
                cells.forEach(cell => cell.innerHTML = '');

                if(show) {
                    cells.forEach(cell => {
                        const node = this.nodeFromElement(cell);
                        if (node.visited) {
                            const debug = `F: ${node.f}<br />G: ${node.g}<br />H: ${node.h}`;
                            cell.innerHTML = debug;
                        }
                    });
                }
            }

            nodeFromElement(cell) {
                const x = parseInt(cell.getAttribute('x'));
                const y = parseInt(cell.getAttribute('y'));
                return this.graph.nodes[x][y];
            }

            animateNoPath() {
                const graph = this.graph_el;
                const jiggle = (lim, i = 0) => {
                    if(i >= lim) {
                        graph.style.top = '0';
                        graph.style.left = '0';
                        return;
                    }
                    graph.style.top = (Math.random() * 6) + 'px';
                    graph.style.left = (Math.random() * 6) + 'px';
                    setTimeout(() => jiggle(lim, i + 1), 5);
                };
                jiggle(15);
            }

            animatePath(path) {
                const grid = this.grid;
                const timeout = 1000 / grid.length;
                const elementFromNode = (node) => grid[node.x][node.y];

                const removeClass = (path, i) => {
                    if(i >= path.length) return;
                    elementFromNode(path[i]).classList.remove(css.active);
                    setTimeout(() => removeClass(path, i + 1), timeout * path[i].cost);
                };

                const addClass = (path, i) => {
                    if(i >= path.length) {
                        return removeClass(path, 0);
                    }
                    elementFromNode(path[i]).classList.add(css.active);
                    setTimeout(() => addClass(path, i + 1), timeout * path[i].cost);
                };

                addClass(path, 0);

                const startCells = this.graph_el.querySelectorAll('.' + css.start);
                startCells.forEach(cell => cell.classList.remove(css.start));

                const finishCells = this.graph_el.querySelectorAll('.' + css.finish);
                finishCells.forEach(cell => {
                    cell.classList.remove(css.finish);
                    cell.classList.add(css.start);
                });
            }
}
    </script>
}