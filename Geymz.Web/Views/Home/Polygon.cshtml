<style>
    #polygonForm table button {
        margin-top: 1.5em;
        border: none;
        color: ghostwhite;
        cursor: pointer;
        border-diameter: 1.3em;
        padding: 1em 2em;
        background: darkgreen;
        transition: all 0.3s ease;
    }

    #polygonForm button:focus {
        outline: none;
    }

    #polygonForm button:hover {
        opacity: 0.8;
        background: darkseagreen;
    }
</style>
<div>
    <form id="polygonForm">
        <table align="center">
            <caption>Polygon generator</caption>
            <tr>
                <td>
                    <label for="sides">Number of Sides:</label>
                    <input type="number" id="sides" value="5" min="3">
                </td>
            </tr>
            <tr>
                <td>
                    <label for="diameter">Diameter:</label>
                    <input type="number" id="diameter" value="50" min="10">
                </td>
            </tr>
            <tr>
                <td>
                    <label for="fillColor">Fill Color:</label>
                    <input type="color" id="fillColor" value="#ADD8E6">
                </td>
            </tr>
            <tr>
                <td>
                    <button type="submit">Draw Polygon</button>
                </td>
            </tr>

        </table>
    </form>
    <canvas id="myCanvas" width="500" height="500" style="border:1px dashed #111;margin: 0% 25%;"></canvas>
</div>

@section Scripts {
    <script>
        const canvas = document.getElementById('myCanvas');
        const ctx = canvas.getContext('2d');
        const numSides = 5; // For a pentagon
        const diameter = 50;
        const centerX = canvas.width / 2;
        const centerY = canvas.height / 2;
        const points = [];
        let radius=diameter/2;
        for (let i = 0; i < numSides; i++) {
            const angle = (Math.PI * 2 * i / numSides) - (Math.PI / 2); // Start at the top
            const x = centerX + radius * Math.cos(angle);
            const y = centerY + radius * Math.sin(angle);
            points.push({ x, y });
        }
        ctx.beginPath();
        ctx.moveTo(points[0].x, points[0].y);
        for (let i = 1; i < points.length; i++) {
            ctx.lineTo(points[i].x, points[i].y);
        }
        ctx.closePath();
        ctx.stroke(); // Draw the outline
        ctx.fillStyle = document.getElementById('fillColor').value;
        ctx.fill();   // Fill the polygon
        // Animate rotation
        let angle = 0;
        function drawPolygon(){
            const numSides = parseInt(document.getElementById('sides').value);
            const diameter = parseInt(document.getElementById('diameter').value);
            let radius=diameter/2;
            const fillColor = document.getElementById('fillColor').value;

            // Clear previous drawing
            ctx.clearRect(0, 0, canvas.width, canvas.height);

            // Recalculate and draw with new parameters
            const points = [];
            for (let i = 0; i < numSides; i++) {
                const angle = (Math.PI * 2 * i / numSides) - (Math.PI / 2);
                const x = centerX + radius * Math.cos(angle);
                const y = centerY + radius * Math.sin(angle);
                points.push({ x, y });
            }

            ctx.beginPath();
            ctx.moveTo(points[0].x, points[0].y);
            for (let i = 1; i < points.length; i++) {
                ctx.lineTo(points[i].x, points[i].y);
            }
            ctx.closePath();
            ctx.fillStyle = fillColor;
            ctx.fill();
            ctx.stroke();
        }
                
        function animate() {
          ctx.clearRect(0, 0, canvas.width, canvas.height);
          drawPolygon();
          angle += 0.01;
          requestAnimationFrame(animate);
        }
        
        document.getElementById('polygonForm').addEventListener('submit', function (event) {
            event.preventDefault(); // Prevent default form submission
            animate();
        });
        animate();
    </script>
}
